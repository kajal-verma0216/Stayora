<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Stayora</title>
</head>
<body>
    <form method="POST" action="/listings/<%= listing._id %>?_method=PUT">
        <input name="listing[title]" placeholder="Enter title" type="text" value="<%= listing.title %>">
        <br><br>
        <textarea name="listing[description]" placeholder="Enter description"><%= listing.description %></textarea>
        <br><br>
        <input name="listing[image][url]" placeholder="Enter image URL" type="url" value="<%= listing.image.url %>">
        <br><br>
        <input name="listing[price]" placeholder="Enter price" type="number" value="<%= listing.price %>">
        <br><br>
        <input name="listing[country]" placeholder="Enter country" type="text" value="<%= listing.country %>">
        <br><br>
        <input name="listing[location]" placeholder="Enter location" type="text" value="<%= listing.location %>">
        <br><br>
        <button type="submit">Save</button>
    </form>
</body>
</html>